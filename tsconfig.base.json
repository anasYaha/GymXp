{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@gymxp/shared-types/*": [
        "packages/shared-types/src/*"
      ],
      "@gymxp/config/*": [
        "packages/config/*"
      ],
      "@gymxp/ui/*": [
        "packages/ui/src/*"
      ]
    }
  }
}

