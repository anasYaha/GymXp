model BranchSessionOption {
  id           String              @id @default(cuid())
  branchId     String
  branch       GymBranch           @relation(fields: [branchId], references: [id])
  title        String
  description  String?
  coachName    String?
  startsAt     DateTime
  durationMins Int
  muscleGroup  String
  attendances  SessionAttendance[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([branchId, startsAt])
}

