model WorkoutSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  branchId    String
  branch      GymBranch     @relation(fields: [branchId], references: [id])
  muscleGroup String
  startedAt   DateTime
  endedAt     DateTime?
  status      WorkoutStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model XPLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  branchId  String
  branch    GymBranch @relation(fields: [branchId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime  @default(now())
}

model StreakSnapshot {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  branchId   String
  branch     GymBranch @relation(fields: [branchId], references: [id])
  streakDays Int
  recordedAt DateTime
  createdAt  DateTime  @default(now())
}

model LeaderboardSnapshot {
  id         String    @id @default(cuid())
  branchId   String
  branch     GymBranch @relation(fields: [branchId], references: [id])
  userId     String
  rank       Int
  xp         Int
  snapshotAt DateTime
  createdAt  DateTime  @default(now())
}

model BranchAnalyticsSnapshot {
  id                 String    @id @default(cuid())
  branchId           String
  branch             GymBranch @relation(fields: [branchId], references: [id])
  activeMembers      Int
  sessionsCount      Int
  averageSessionMins Int
  peakWindow         String?
  muscleGroupSummary Json?
  recordedAt         DateTime
  createdAt          DateTime  @default(now())
}
