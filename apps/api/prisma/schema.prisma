generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  BRANCH_ADMIN
  BRAND_OWNER
  PLATFORM_ADMIN
}

enum WorkoutStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model GymBrand {
  id        String      @id @default(cuid())
  name      String
  branches  GymBranch[]
  users     User[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model GymBranch {
  id                 String                     @id @default(cuid())
  brandId            String
  brand              GymBrand                   @relation(fields: [brandId], references: [id])
  name               String
  city               String
  address            String?
  users              User[]                     @relation("CurrentBranchUsers")
  workoutSessions    WorkoutSession[]
  xpLogs             XPLog[]
  streakSnapshots    StreakSnapshot[]
  leaderboardEntries LeaderboardSnapshot[]
  analyticsSnapshots BranchAnalyticsSnapshot[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
}

model User {
  id              String           @id @default(cuid())
  fullName        String
  email           String           @unique
  passwordHash    String
  brandId         String
  brand           GymBrand         @relation(fields: [brandId], references: [id])
  currentBranchId String?
  currentBranch   GymBranch?       @relation("CurrentBranchUsers", fields: [currentBranchId], references: [id])
  role            UserRole         @default(MEMBER)
  sessions        WorkoutSession[]
  xpLogs          XPLog[]
  streaks         StreakSnapshot[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model WorkoutSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  branchId    String
  branch      GymBranch     @relation(fields: [branchId], references: [id])
  muscleGroup String
  startedAt   DateTime
  endedAt     DateTime?
  status      WorkoutStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model XPLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  branchId  String
  branch    GymBranch @relation(fields: [branchId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime  @default(now())
}

model StreakSnapshot {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  branchId   String
  branch     GymBranch @relation(fields: [branchId], references: [id])
  streakDays Int
  recordedAt DateTime
  createdAt  DateTime  @default(now())
}

model LeaderboardSnapshot {
  id         String    @id @default(cuid())
  branchId   String
  branch     GymBranch @relation(fields: [branchId], references: [id])
  userId     String
  rank       Int
  xp         Int
  snapshotAt DateTime
  createdAt  DateTime  @default(now())
}

model BranchAnalyticsSnapshot {
  id                 String    @id @default(cuid())
  branchId           String
  branch             GymBranch @relation(fields: [branchId], references: [id])
  activeMembers      Int
  sessionsCount      Int
  averageSessionMins Int
  peakWindow         String?
  muscleGroupSummary Json?
  recordedAt         DateTime
  createdAt          DateTime  @default(now())
}
