generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  BRANCH_ADMIN
  BRAND_OWNER
  PLATFORM_ADMIN
}

enum WorkoutStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model GymBrand {
  id        String      @id @default(cuid())
  name      String
  branches  GymBranch[]
  users     User[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

