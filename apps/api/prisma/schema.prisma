generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["gymxp"]
}

enum UserRole {
  MEMBER
  BRANCH_ADMIN
  BRAND_OWNER
  PLATFORM_ADMIN

  @@schema("gymxp")
}

enum WorkoutStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@schema("gymxp")
}

model GymBrand {
  id        String      @id @default(cuid())
  name      String
  branches  GymBranch[]
  users     User[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@schema("gymxp")
}

model GymBranch {
  id                 String                     @id @default(cuid())
  brandId            String
  brand              GymBrand                   @relation(fields: [brandId], references: [id])
  name               String
  city               String
  address            String?
  users              User[]                     @relation("CurrentBranchUsers")
  workoutSessions    WorkoutSession[]
  sessionOptions     BranchSessionOption[]
  sessionAttendances SessionAttendance[]
  xpLogs             XPLog[]
  streakSnapshots    StreakSnapshot[]
  leaderboardEntries LeaderboardSnapshot[]
  analyticsSnapshots BranchAnalyticsSnapshot[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@schema("gymxp")
}

model User {
  id              String           @id @default(cuid())
  fullName        String
  email           String           @unique
  passwordHash    String
  brandId         String
  brand           GymBrand         @relation(fields: [brandId], references: [id])
  currentBranchId String?
  currentBranch   GymBranch?       @relation("CurrentBranchUsers", fields: [currentBranchId], references: [id])
  role            UserRole         @default(MEMBER)
  
  level           Int              @default(1)
  totalXp         Int              @default(0)
  totalSessions   Int              @default(0)
  currentStreak   Int              @default(0)
  levelXpProgress Int              @default(0)
  levelDaysProgress Int            @default(0)
  age             Int?
  avatarUrl       String?

  sessions        WorkoutSession[]
  sessionAttendances SessionAttendance[]
  xpLogs          XPLog[]
  streaks         StreakSnapshot[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@schema("gymxp")
}

model BranchSessionOption {
  id           String              @id @default(cuid())
  branchId     String
  branch       GymBranch           @relation(fields: [branchId], references: [id])
  title        String
  description  String?
  coachName    String?
  startsAt     DateTime
  durationMins Int
  muscleGroup  String
  attendances  SessionAttendance[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([branchId, startsAt])
  @@schema("gymxp")
}

model SessionAttendance {
  id              String              @id @default(cuid())
  sessionOptionId String
  sessionOption   BranchSessionOption @relation(fields: [sessionOptionId], references: [id])
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  branchId        String
  branch          GymBranch           @relation(fields: [branchId], references: [id])
  checkedInAt     DateTime            @default(now())
  createdAt       DateTime            @default(now())

  @@unique([sessionOptionId, userId])
  @@index([userId, branchId, checkedInAt])
  @@schema("gymxp")
}

model WorkoutSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  branchId    String
  branch      GymBranch     @relation(fields: [branchId], references: [id])
  muscleGroup String
  completionDay DateTime?
  startedAt   DateTime
  endedAt     DateTime?
  status      WorkoutStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, completionDay])
  @@schema("gymxp")
}

model XPLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  branchId  String
  branch    GymBranch @relation(fields: [branchId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime  @default(now())

  @@schema("gymxp")
}

model StreakSnapshot {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  branchId   String
  branch     GymBranch @relation(fields: [branchId], references: [id])
  streakDays Int
  recordedAt DateTime
  createdAt  DateTime  @default(now())

  @@schema("gymxp")
}

model LeaderboardSnapshot {
  id         String    @id @default(cuid())
  branchId   String
  branch     GymBranch @relation(fields: [branchId], references: [id])
  userId     String
  rank       Int
  xp         Int
  snapshotAt DateTime
  createdAt  DateTime  @default(now())

  @@schema("gymxp")
}

model BranchAnalyticsSnapshot {
  id                 String    @id @default(cuid())
  branchId           String
  branch             GymBranch @relation(fields: [branchId], references: [id])
  activeMembers      Int
  sessionsCount      Int
  averageSessionMins Int
  peakWindow         String?
  muscleGroupSummary Json?
  recordedAt         DateTime
  createdAt          DateTime  @default(now())

  @@schema("gymxp")
}
